---
import SectionTitle from "@shared/components/ui/SectionTitle.astro";
import { getCollection } from "astro:content";

const clients = await getCollection("clients");
---

<section class="mb-12">
  <SectionTitle>Clients</SectionTitle>
  <div class="overflow-hidden rounded-2xl border-2 border-glass-border bg-white/5 p-6 md:p-8">
    <ul id="clients-content" class="flex gap-6 overflow-x-auto scrollbar-none">
      {clients.map((client) => (
        <li class="flex min-w-28 shrink-0 items-center justify-center opacity-50 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0 sm:min-w-32 md:min-w-36">
          <div class="text-center text-sm font-bold tracking-widest text-text-muted uppercase sm:text-base">
            {client.data.alt}
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div id="clients-scrollbar" class="has-scrollbar mt-6 overflow-x-auto">
    <div id="clients-scrollbar-inner" class="h-px"></div>
  </div>
</section>

<script>
  const sync = () => {
    const content = document.querySelector<HTMLElement>("#clients-content");
    const bar = document.querySelector<HTMLElement>("#clients-scrollbar");
    const inner = document.querySelector<HTMLElement>("#clients-scrollbar-inner");
    if (!content || !bar || !inner) return;

    inner.style.width = `${content.scrollWidth}px`;

    const maxScroll = (el: HTMLElement) => el.scrollWidth - el.clientWidth;

    let syncing = false;
    content.addEventListener("scroll", () => {
      if (syncing) return;
      syncing = true;
      const ratio = maxScroll(content) ? content.scrollLeft / maxScroll(content) : 0;
      bar.scrollLeft = ratio * maxScroll(bar);
      syncing = false;
    });
    bar.addEventListener("scroll", () => {
      if (syncing) return;
      syncing = true;
      const ratio = maxScroll(bar) ? bar.scrollLeft / maxScroll(bar) : 0;
      content.scrollLeft = ratio * maxScroll(content);
      syncing = false;
    });
  };
  document.addEventListener("astro:page-load", sync);
</script>
