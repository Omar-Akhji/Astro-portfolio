---
import SectionTitle from "@shared/components/ui/SectionTitle.astro";
import { getCollection } from "astro:content";

const clients = await getCollection("clients");
---

<section class="mb-12">
  <SectionTitle>Clients</SectionTitle>
  <div class="rounded-2xl border-2 border-glass-border bg-white/5 p-6 md:p-8">
    <ul class="grid grid-cols-2 items-center justify-items-center gap-6 sm:grid-cols-3 md:grid-cols-6">
      {clients.map((client) => (
        <li class="flex w-full items-center justify-center opacity-50 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0">
          <div class="text-center text-sm font-bold tracking-widest text-text-muted uppercase sm:text-base md:text-sm lg:text-base">
            {client.data.alt}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
