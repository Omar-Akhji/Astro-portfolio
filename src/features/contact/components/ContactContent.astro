---
// Pure TypeScript + Astro Contact Form & Map Component
---

<div>
  <!-- ── Map ── -->
  <section class="mbe-10">
    <div
      id="map-container"
      class="relative overflow-hidden rounded-2xl border-2 border-glass-border bg-white/5 block-62.5 inline-full sm:block-100"
    >
      <button
        id="load-map-btn"
        aria-label="Load interactive map"
        class="flex h-full w-full cursor-pointer flex-col items-center justify-center gap-3 transition-colors hover:bg-white/5"
        type="button"
      >
        <svg
          class="size-10 text-blueviolet opacity-60"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.25"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
          <circle
            cx="12"
            cy="10"
            r="3"
          ></circle>
        </svg>
        <span class="text-sm font-medium text-text-muted"> Click to load map </span>
        <span class="text-xs text-text-muted/50">Rabat, Morocco</span>
      </button>
      <div
        id="map-frame-wrapper"
        class="hidden h-full w-full"
      ></div>
    </div>
  </section>

  <!-- ── Contact Form ── -->
  <section>
    <h3 class="mbe-6 text-xl font-semibold text-text capitalize sm:text-2xl">Contact Form</h3>

    <!-- Status Banner -->
    <div
      id="contact-status-banner"
      class="hidden mbe-6 items-center gap-3 rounded-xl border-2 p-4"
      role="alert"
    >
      <svg
        id="banner-icon-success"
        class="hidden size-5 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.25"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M21.801 10A10 10 0 1 1 17 3.335"></path>
        <path d="m9 11 3 3L22 4"></path>
      </svg>
      <svg
        id="banner-icon-error"
        class="hidden size-5 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.25"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle
          cx="12"
          cy="12"
          r="10"
        ></circle>
        <line
          x1="12"
          x2="12"
          y1="8"
          y2="12"
        ></line>
        <line
          x1="12"
          x2="12.01"
          y1="16"
          y2="16"
        ></line>
      </svg>
      <p
        id="banner-message"
        class="text-sm font-medium"
      ></p>
    </div>

    <form
      id="contact-form"
      class="space-y-6"
    >
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <label
            class="sr-only"
            for="full-name"
          >
            Full name
          </label>
          <input
            id="full-name"
            class="rounded-xl border-2 border-glass-border bg-card p-4 text-text transition-all inline-full placeholder:text-text-muted user-valid:border-green-500/50! user-invalid:border-red-500/50! focus:border-blueviolet focus:ring-1 focus:ring-blueviolet/50 focus:outline-none"
            name="fullName"
            placeholder="Full name"
            required
            type="text"
          />
          <p
            id="full-name-error"
            class="hidden mbs-1.5 text-xs font-medium text-red-400"
          ></p>
        </div>
        <div>
          <label
            class="sr-only"
            for="email"
          >
            Email address
          </label>
          <input
            id="email"
            class="rounded-xl border-2 border-glass-border bg-card p-4 text-text transition-all inline-full placeholder:text-text-muted user-valid:border-green-500/50! user-invalid:border-red-500/50! focus:border-blueviolet focus:ring-1 focus:ring-blueviolet/50 focus:outline-none"
            name="email"
            placeholder="Email address"
            required
            type="email"
          />
          <p
            id="email-error"
            class="hidden mbs-1.5 text-xs font-medium text-red-400"
          ></p>
        </div>
      </div>

      <div>
        <label
          class="sr-only"
          for="message"
        >
          Your Message
        </label>
        <textarea
          id="message"
          class="resize-y rounded-xl border-2 border-glass-border bg-card p-4 text-text transition-all inline-full min-block-37.5 placeholder:text-text-muted user-valid:border-green-500/50! user-invalid:border-red-500/50! focus:border-blueviolet focus:ring-1 focus:ring-blueviolet/50 focus:outline-none"
          name="message"
          placeholder="Your Message"
          required
        ></textarea>
        <p
          id="message-error"
          class="hidden mt-1.5 text-xs font-medium text-red-400"
        ></p>
      </div>

      <!-- ── Human Verification (CAPTCHA) Widget ── -->
      <div>
        <div
          id="captcha-widget"
          class="relative overflow-hidden rounded-xl border-2 border-glass-border bg-card p-4 transition-all duration-300 hover:border-glass-border/80 focus-within:border-blueviolet/50"
        >
          <!-- Subtle background glow -->
          <div
            id="captcha-glow"
            class="pointer-events-none absolute -right-12 -top-12 size-36 rounded-full bg-blueviolet/10 blur-2xl transition-all duration-500 opacity-40"
          ></div>

          <div class="relative flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <!-- Left: Interactive Checkbox & Status -->
            <div class="flex items-center gap-3.5">
              <button
                id="captcha-btn"
                type="button"
                role="checkbox"
                aria-checked="false"
                aria-labelledby="captcha-title"
                class="group relative flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-lg border-2 border-blueviolet/60 bg-white/5 transition-all duration-300 hover:scale-105 hover:border-blueviolet hover:bg-blueviolet/15 hover:shadow-[0_0_15px_rgba(99,70,230,0.35)] focus:border-blueviolet focus:ring-2 focus:ring-blueviolet/40 focus:outline-none"
              >
                <!-- Idle State: Subtle outline dot -->
                <span
                  id="captcha-idle-icon"
                  class="size-2 rounded-full bg-blueviolet/60 transition-transform group-hover:scale-125"
                ></span>

                <!-- Verifying Spinner -->
                <svg
                  id="captcha-spinner"
                  class="hidden size-4 animate-spin text-blueviolet"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle
                    class="opacity-20"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="3"
                  ></circle>
                  <path
                    class="opacity-90"
                    d="M12 2a10 10 0 0 1 10 10"
                    stroke="currentColor"
                    stroke-width="3"
                  ></path>
                </svg>

                <!-- Verified Checkmark -->
                <svg
                  id="captcha-check-icon"
                  class="hidden size-4.5 text-green-400 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>

              <div class="flex flex-col">
                <span
                  id="captcha-title"
                  class="text-sm font-medium text-text select-none transition-colors duration-200"
                >
                  Verify you are human
                </span>
                <span
                  id="captcha-subtext"
                  class="text-xs text-text-muted/70 select-none transition-colors duration-200"
                >
                  Click the checkbox to verify
                </span>
              </div>
            </div>

            <!-- Right: Enterprise Security Badge -->
            <div class="flex items-center gap-2 border-t border-glass-border/50 pt-2.5 sm:border-t-0 sm:pt-0">
              <svg
                class="size-4.5 text-blueviolet/80 shrink-0"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <div class="flex flex-col leading-tight select-none">
                <span class="text-[11px] font-semibold text-text-muted/90 uppercase tracking-wider">
                  Shield Guard
                </span>
                <span class="text-[10px] text-text-muted/50">Bot &amp; Spam Protection</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hidden Captcha Token & Honeypot Inputs -->
        <input
          id="captcha-token"
          type="hidden"
          name="captchaToken"
          value=""
        />
        <input
          id="_gotcha_hp"
          type="text"
          name="_gotcha_hp"
          tabindex="-1"
          autocomplete="off"
          class="sr-only"
          aria-hidden="true"
          style="position: absolute; opacity: 0; pointer-events: none;"
        />

        <!-- Captcha Error Feedback -->
        <p
          id="captcha-error"
          class="hidden mt-1.5 text-xs font-medium text-red-400"
        ></p>
      </div>

      <button
        id="submit-btn"
        class="group relative flex w-full cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-xl border-2 border-blueviolet bg-card px-6 py-3.5 font-semibold text-blueviolet shadow-1 transition-all duration-300 before:absolute before:inset-0 before:bg-linear-to-r before:from-violet before:to-blueviolet before:opacity-0 before:transition-opacity before:duration-300 hover:border-transparent hover:text-bg hover:shadow-[0_0_20px_rgba(99,70,230,0.4)] hover:before:opacity-100 active:scale-95 disabled:pointer-events-none disabled:opacity-60 sm:ml-auto sm:w-auto sm:py-3"
        type="submit"
      >
        <svg
          id="submit-spinner"
          class="relative z-10 hidden size-5 animate-spin"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.25"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
        </svg>
        <svg
          id="submit-icon"
          class="hidden"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.25"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
          <path d="m21.854 2.147-10.94 10.939"></path>
        </svg>
        <span
          id="submit-label"
          class="relative z-10"
        >
          Send Message
        </span>
      </button>
    </form>
  </section>
</div>

<script src="@features/contact/scripts/contact.ts"></script>
