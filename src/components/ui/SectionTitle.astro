---
const { icon: Icon } = Astro.props;
---

<header class:list={[`mb-6 flex items-center`, { "gap-4": Icon }]}>
  {
    Icon && (
      <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-glass-border bg-card text-blueviolet shadow-1">
        <Icon
          class="size-6"
          stroke-width={1.25}
        />
      </div>
    )
  }
  <h3 class="text-xl font-semibold text-text capitalize sm:text-2xl">
    <slot />
  </h3>
</header>
