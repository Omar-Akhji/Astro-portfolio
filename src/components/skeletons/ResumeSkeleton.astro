---
// Pure gray skeleton matching Resume page layout, timelines, and skills
---

<article class="z-1 animate-fade-in min-h-[calc(100vh-8rem)] w-full min-w-70 rounded-card border-2 border-glass-border bg-bg p-4 pbe-16 shadow-1 sm:p-8 sm:pbe-28 lg:shadow-5">
  <!-- ── Page Title + Underline ── -->
  <header class="mb-8">
    <div class="h-8 w-28 animate-pulse rounded-md bg-neutral-700/50 sm:h-10 sm:w-36"></div>
    <div class="mt-2 h-0.75 w-8 rounded-sm bg-neutral-600 sm:mt-3 sm:h-1.25 sm:w-10"></div>
  </header>

  <!-- ── Education Section ── -->
  <section class="mb-8">
    <header class="mb-6 flex items-center gap-4">
      <div class="flex size-10 shrink-0 animate-pulse items-center justify-center rounded-full border-2 border-glass-border bg-card/60"></div>
      <div class="h-7 w-32 animate-pulse rounded-md bg-neutral-700/50"></div>
    </header>
    <div class="relative space-y-0">
      {["edu-1", "edu-2", "edu-3"].map((_, index) => (
        <div class="relative flex gap-4 md:gap-6">
          <div class="flex w-10 shrink-0 flex-col items-center">
            <div class="flex h-6 flex-col items-center justify-center">
              <div class="size-4 shrink-0 animate-pulse rounded-full bg-neutral-600 ring-4 ring-neutral-700/30" />
            </div>
            {index < 2 && <div class="my-3 w-0.5 grow rounded-full bg-neutral-700/30" />}
          </div>
          <div class="grow pb-8">
            <div class="mb-1.5 h-5 w-3/5 animate-pulse rounded bg-neutral-700/50" />
            <div class="mb-2 h-4 w-28 animate-pulse rounded bg-neutral-700/30" />
            <div class="space-y-1.5">
              <div class="h-3.5 w-full animate-pulse rounded bg-neutral-700/30" />
              <div class="h-3.5 w-4/5 animate-pulse rounded bg-neutral-700/30" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Experience Section ── -->
  <section class="mt-12 mb-8">
    <header class="mb-6 flex items-center gap-4">
      <div class="flex size-10 shrink-0 animate-pulse items-center justify-center rounded-full border-2 border-glass-border bg-card/60"></div>
      <div class="h-7 w-36 animate-pulse rounded-md bg-neutral-700/50"></div>
    </header>
    <div class="relative space-y-0">
      {["exp-1", "exp-2", "exp-3"].map((_, index) => (
        <div class="relative flex gap-4 md:gap-6">
          <div class="flex w-10 shrink-0 flex-col items-center">
            <div class="flex h-6 flex-col items-center justify-center">
              <div class="size-4 shrink-0 animate-pulse rounded-full bg-neutral-600 ring-4 ring-neutral-700/30" />
            </div>
            {index < 2 && <div class="my-3 w-0.5 grow rounded-full bg-neutral-700/30" />}
          </div>
          <div class="grow pb-8">
            <div class="mb-1.5 h-5 w-2/3 animate-pulse rounded bg-neutral-700/50" />
            <div class="mb-2 h-4 w-32 animate-pulse rounded bg-neutral-700/30" />
            <div class="space-y-1.5">
              <div class="h-3.5 w-full animate-pulse rounded bg-neutral-700/30" />
              <div class="h-3.5 w-3/4 animate-pulse rounded bg-neutral-700/30" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Technical Skills Section ── -->
  <section class="mt-12 mb-8">
    <header class="mb-6 flex items-center gap-4">
      <div class="flex size-10 shrink-0 animate-pulse items-center justify-center rounded-full border-2 border-glass-border bg-card/60"></div>
      <div class="h-7 w-44 animate-pulse rounded-md bg-neutral-700/50"></div>
    </header>
    <div class="rounded-2xl border-2 border-glass-border bg-white/5 p-8">
      <ul class="space-y-6">
        {[
          { nameW: "w-28", fillW: "w-4/5" },
          { nameW: "w-36", fillW: "w-3/4" },
          { nameW: "w-32", fillW: "w-5/6" },
          { nameW: "w-24", fillW: "w-2/3" },
          { nameW: "w-20", fillW: "w-3/4" },
          { nameW: "w-36", fillW: "w-1/2" },
        ].map((item) => (
          <li>
            <div class="mb-2 flex items-center justify-between">
              <div class:list={["h-4 animate-pulse rounded bg-neutral-700/50", item.nameW]} />
              <div class="h-4 w-10 animate-pulse rounded bg-neutral-700/35" />
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-neutral-800/80">
              <div
                class:list={["h-full animate-pulse rounded-full bg-neutral-600/70", item.fillW]}
              />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</article>
