---
// Pure gray skeleton matching AboutContent layout and components
---

<article class="z-1 animate-fade-in min-h-[calc(100vh-8rem)] w-full min-w-70 rounded-card border-2 border-glass-border bg-bg p-4 pbe-16 shadow-1 sm:p-8 sm:pbe-28 lg:shadow-5">
  <!-- ── Page Title + Underline ── -->
  <header class="mb-8">
    <div class="h-8 w-36 animate-pulse rounded-md bg-neutral-700/50 sm:h-10 sm:w-44"></div>
    <div class="mt-2 h-0.75 w-8 rounded-sm bg-neutral-600 sm:mt-3 sm:h-1.25 sm:w-10"></div>
  </header>

  <!-- ── Intro Paragraphs ── -->
  <section class="mb-8 space-y-4">
    <div class="space-y-2.5">
      <div class="h-4 w-full animate-pulse rounded bg-neutral-700/35"></div>
      <div class="h-4 w-11/12 animate-pulse rounded bg-neutral-700/35"></div>
      <div class="h-4 w-4/5 animate-pulse rounded bg-neutral-700/35"></div>
    </div>
    <div class="space-y-2.5">
      <div class="h-4 w-full animate-pulse rounded bg-neutral-700/35"></div>
      <div class="h-4 w-full animate-pulse rounded bg-neutral-700/35"></div>
      <div class="h-4 w-3/4 animate-pulse rounded bg-neutral-700/35"></div>
    </div>
  </section>

  <!-- ── What I'm Doing Section ── -->
  <section class="mb-8">
    <div class="mb-6 h-7 w-44 animate-pulse rounded-md bg-neutral-700/50"></div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-6">
      {["s1", "s2", "s3", "s4"].map(() => (
        <div class="rounded-2xl border-2 border-glass-border bg-white/5 p-6">
          <div class="flex gap-4">
            <div class="size-16 shrink-0 animate-pulse rounded-full border-2 border-neutral-700/30 bg-neutral-800/60" />
            <div class="grow space-y-2 pt-1">
              <div class="h-5 w-2/5 animate-pulse rounded bg-neutral-700/50" />
              <div class="h-3.5 w-full animate-pulse rounded bg-neutral-700/30" />
              <div class="h-3.5 w-4/5 animate-pulse rounded bg-neutral-700/30" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Programming Languages Section ── -->
  <section class="mb-8">
    <div class="mb-6 h-7 w-60 animate-pulse rounded-md bg-neutral-700/50"></div>
    <div class="rounded-2xl border-2 border-glass-border bg-white/5 p-6">
      <div class="flex flex-wrap items-center justify-center gap-6 sm:justify-start lg:gap-8">
        {["l1", "l2", "l3", "l4", "l5", "l6", "l7", "l8", "l9"].map(() => (
          <div class="flex size-14 animate-pulse items-center justify-center rounded-full bg-neutral-800/60 p-3" />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Testimonials Section ── -->
  <section class="mb-8">
    <div class="mb-6 h-7 w-36 animate-pulse rounded-md bg-neutral-700/50"></div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {["t1", "t2"].map(() => (
        <div class="rounded-2xl border-2 border-glass-border bg-white/5 p-6">
          <div class="flex items-center gap-4">
            <div class="size-14 shrink-0 animate-pulse rounded-full bg-neutral-800/60" />
            <div class="space-y-1.5">
              <div class="h-4 w-32 animate-pulse rounded bg-neutral-700/50" />
              <div class="h-3 w-20 animate-pulse rounded bg-neutral-700/30" />
            </div>
          </div>
          <div class="mt-4 space-y-2">
            <div class="h-3.5 w-full animate-pulse rounded bg-neutral-700/30" />
            <div class="h-3.5 w-5/6 animate-pulse rounded bg-neutral-700/30" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Clients Section ── -->
  <section>
    <div class="mb-6 h-7 w-28 animate-pulse rounded-md bg-neutral-700/50"></div>
    <div class="flex flex-wrap items-center justify-around gap-6 rounded-2xl border-2 border-glass-border bg-white/5 p-6">
      {["c1", "c2", "c3", "c4", "c5"].map(() => (
        <div class="h-10 w-24 animate-pulse rounded-lg bg-neutral-800/60 sm:w-28" />
      ))}
    </div>
  </section>
</article>
