<div
  class="z-1 animate-fade-in rounded-card border border-glass-border bg-bg p-4 pb-16 shadow-1 sm:mx-auto sm:w-130 sm:p-8 sm:pb-28 md:w-175 lg:w-237.5 lg:shadow-5 xl:min-h-full xl:w-auto"
>
  <!-- ── Page Title "Blog" + underline ── -->
  <div class="mb-8 pb-2 sm:pb-4">
    <div class="h-8 w-20 animate-pulse rounded bg-white/10 sm:h-9"></div>
    <div
      class="mt-2 h-0.75 w-8 rounded-sm bg-linear-to-r from-blueviolet to-violet sm:mt-3 sm:h-1.25 sm:w-10"
    >
    </div>
  </div>

  <!-- ── Blog Cards Grid ── -->
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
    {
      ["b1", "b2", "b3", "b4"].map(() => (
        <div class="overflow-hidden rounded-2xl border border-glass-border bg-white/5 p-4">
          {/* Large image area */}
          <div class="aspect-4/3 w-full animate-pulse rounded-xl bg-white/8 lg:h-57.5" />

          {/* Content below image */}
          <div class="pt-4 sm:px-2 sm:pt-6">
            {/* Category badge + date row */}
            <div class="mb-3 flex items-center gap-3">
              <div class="h-7 w-20 animate-pulse rounded-full bg-white/10" />
              <div class="h-4 w-28 animate-pulse rounded bg-white/8" />
            </div>

            {/* Post title */}
            <div class="mb-3 h-6 w-4/5 animate-pulse rounded bg-white/12 sm:h-7" />

            {/* Description text (2 lines) */}
            <div class="space-y-2">
              <div class="h-4 w-full animate-pulse rounded bg-white/8" />
              <div class="h-4 w-3/5 animate-pulse rounded bg-white/8" />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
