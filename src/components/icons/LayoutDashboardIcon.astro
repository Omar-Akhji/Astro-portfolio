---
interface Props {
  class?: string;
  "stroke-width"?: number | string;
}

const { class: className = "size-6", "stroke-width": strokeWidth = 1.25 } = Astro.props;
---

<svg
  class:list={[className]}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width={strokeWidth}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect
    height="9"
    rx="1"
    width="7"
    x="3"
    y="3"
  ></rect>
  <rect
    height="5"
    rx="1"
    width="7"
    x="14"
    y="3"
  ></rect>
  <rect
    height="9"
    rx="1"
    width="7"
    x="14"
    y="12"
  ></rect>
  <rect
    height="5"
    rx="1"
    width="7"
    x="3"
    y="16"
  ></rect>
</svg>
