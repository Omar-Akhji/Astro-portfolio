---
interface Props {
  class?: string;
  "stroke-width"?: number | string;
}

const { class: className = "size-6", "stroke-width": strokeWidth = 1.25 } = Astro.props;
---

<svg
  class:list={[className]}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width={strokeWidth}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect
    height="14"
    rx="2"
    width="20"
    x="2"
    y="3"
  ></rect>
  <line
    x1="8"
    x2="16"
    y1="21"
    y2="21"
  ></line>
  <line
    x1="12"
    x2="12"
    y1="17"
    y2="21"
  ></line>
</svg>
