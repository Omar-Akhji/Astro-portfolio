---
import Layout from "@shared/layouts/Layout.astro";
import PageWrapper from "@shared/components/ui/PageWrapper.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";

interface StaticPathItem {
  readonly params: { readonly id: string };
  readonly props: { readonly post: CollectionEntry<"blog"> };
}

export async function getStaticPaths(): Promise<readonly StaticPathItem[]> {
  const posts = await getCollection("blog");
  return posts.map((post): StaticPathItem => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  readonly post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

// Calculate reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const articleImage =
  typeof post.data.image === "string" ? post.data.image : post.data.image.src;
---

<Layout
  description={post.data.text}
  extraSchema={{
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.text,
    datePublished: post.data.dateTime,
    keywords: post.data.tags.join(", "),
    articleSection: post.data.category,
    image: articleImage,
    author: {
      "@type": "Person",
      name: "Omar Akhji",
      url: "https://omarakhji.dev",
    },
  }}
  ogImage={articleImage}
  ogType="article"
  publishedTime={post.data.dateTime}
  tags={post.data.tags}
  title={post.data.title}
>
  <PageWrapper>
    <!-- Reading Progress Bar -->
    <div class="progress-container pointer-events-none fixed top-0 left-0 z-50 h-1 w-full bg-transparent">
      <div
        class="progress-bar from-violet to-blueviolet h-full w-full origin-left bg-linear-to-r"
        id="reading-progress"
      ></div>
    </div>

    <!-- Back Button -->
    <div class="mb-6">
      <a
        class="text-text-muted hover:text-blueviolet flex w-max items-center gap-2 text-sm font-medium transition-colors"
        href="/blog"
      >
        <svg
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        Back to Blog
      </a>
    </div>

    <article class="mx-auto w-full min-w-70 max-w-4xl">
      <!-- Header -->
      <header class="mb-8">
        <div class="mb-4 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
          <span class="border-glass-border bg-card text-blueviolet rounded-full border-2 px-3 py-0.5 font-medium sm:py-1">
            {post.data.category}
          </span>
          <span class="text-text-muted/40">&bull;</span>
          <time
            class="text-text-muted flex items-center gap-1.5 font-light"
            datetime={post.data.dateTime}
          >
            <svg
              class="size-3.5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M8 2v3"></path>
              <path d="M16 2v3"></path>
              <rect
                height="18"
                rx="2"
                width="18"
                x="3"
                y="3"
              ></rect>
              <path d="M3 9h18"></path>
            </svg>
            {new Intl.DateTimeFormat("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            }).format(new Date(post.data.dateTime))}
          </time>
          <span class="text-text-muted/40">&bull;</span>
          <span class="text-text-muted flex items-center gap-1.5 font-light">
            <svg
              class="size-3.5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle
                cx="12"
                cy="12"
                r="10"
              ></circle>
              <path d="M12 6v6l4 2"></path>
            </svg>
            {readingTime} min read
          </span>
        </div>

        <h1 class="text-text mb-6 text-3xl leading-tight font-bold tracking-tight sm:text-4xl lg:text-5xl">
          {post.data.title}
        </h1>

        <!-- Article Image -->
        <div class="border-glass-border relative aspect-video min-h-48 max-h-125 w-full overflow-hidden rounded-2xl border-2">
          <img
            alt={post.data.title}
            class="absolute inset-0 h-full w-full object-cover"
            src={typeof post.data.image === "string" ? post.data.image : post.data.image.src}
          />
        </div>
      </header>

      <!-- Markdown Body Content -->
      <section class="prose-custom text-text-muted text-sm leading-relaxed font-light sm:text-base">
        <Content />
      </section>

      <!-- Footer Tags -->
      {post.data.tags.length > 0 && (
        <footer class="mt-12 border-t-2 border-glass-border pt-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="flex items-center gap-1.5 text-xs font-semibold tracking-wider text-text-muted uppercase">
              <svg
                class="size-3.5 text-blueviolet"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
                <circle
                  cx="7.5"
                  cy="7.5"
                  fill="currentColor"
                  r=".5"
                />
              </svg>
              Tags:
            </span>
            {post.data.tags.map((tag: string) => (
              <span class="rounded-lg border-2 bg-white/5 px-2.5 py-1 text-xs text-text-muted transition-colors hover:bg-white/10 hover:text-text">
                #{tag}
              </span>
            ))}
          </div>
        </footer>
      )}
    </article>
  </PageWrapper>
</Layout>
