---
const currentYear = new Date().getFullYear();
const todayISO = new Date().toISOString().slice(0, 10);
---

<footer
  aria-label="Site footer"
  class="absolute bottom-0 left-1/2 z-10 w-max -translate-x-1/2 rounded-t-xl border-2 border-glass-border bg-[oklch(from_var(--color-bg)_l_c_h/75%)] px-4 py-3 shadow-1 backdrop-blur-[10px] xs:rounded-t-2xl xs:px-5 xs:py-3.5 sm:px-6 sm:py-4 md:px-7 md:py-4.5 lg:px-8 lg:py-5 xl:left-0 xl:translate-x-0 xl:rounded-none xl:rounded-tr-2xl xl:rounded-bl-2xl"
  role="contentinfo"
>
  <small class="flex items-center gap-0.5 text-[0.6875rem] font-medium text-text-muted/80 not-italic xs:gap-1 xs:text-xs sm:text-[0.8125rem] md:text-sm lg:text-[0.9375rem]">
    <svg
      class="size-3"
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.25"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle
        cx="12"
        cy="12"
        r="10"
      ></circle>
      <path d="M14.83 14.83a4 4 0 1 1 0-5.66"></path>
    </svg>
    <time datetime={todayISO}>{currentYear}</time>
    <span>Edited by Omar Akhji. All rights reserved.</span>
  </small>
</footer>
