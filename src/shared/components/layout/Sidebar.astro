---
interface Props {
  readonly avatar?: string;
  readonly initials: string;
  readonly name: string;
  readonly title: string;
  readonly contact: {
    readonly email: string;
    readonly phone: string;
    readonly location: string;
    readonly linkedin: string;
    readonly github: string;
  };
  readonly languages: readonly { readonly name: string; readonly level: string }[];
}

const { avatar, initials, name, title, contact, languages } = Astro.props;
const nameParts = name.split(" ");
const firstName = nameParts[0] ?? "";
const lastName = nameParts.slice(1).join(" ");
---

<div class="relative z-1 mbe-4 w-full min-w-70 sm:mbe-8 xl:sticky xl:top-15 xl:mx-0 xl:mbe-0 xl:w-auto xl:max-w-none xl:block-full xl:inline-auto xl:max-block-max">
  <aside
    id="sidebar-aside"
    class="max-block-32 sm:max-block-48 overflow-hidden rounded-card border-2 border-glass-border bg-bg p-4 shadow-1 transition-all duration-500 ease-in-out sm:p-8 lg:shadow-5 xl:pbs-15 xl:block-full xl:max-block-max"
  >
    <!-- ── Sidebar Info Row ── -->
    <header class="relative flex items-center justify-start gap-4 sm:gap-6 xl:flex-col">
      <!-- Avatar -->
      <div class="relative flex size-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 border-[#C0C0C0] bg-linear-to-r from-violet to-blueviolet shadow-2 drop-shadow-lg sm:size-32 xl:mx-auto xl:size-44">
        {avatar ?
          <img
            alt={name}
            class="size-full object-cover object-top"
            decoding="async"
            height="176"
            loading="eager"
            src={avatar}
            width="176"
          />
        : <span class="text-[1.5rem] font-bold text-bg sm:text-[2.5rem] xl:text-[3.5rem]">
            {initials}
          </span>
        }
      </div>

      <!-- Name & Title -->
      <div class="xl:text-center">
        <p class="mbe-2 bg-radial-[at_center_top] from-indigo to-blueviolet bg-clip-text text-[1.0625rem] font-medium tracking-tight text-transparent uppercase sm:mbe-4 sm:text-[1.625rem] xl:whitespace-nowrap">
          {firstName} <span class="font-extrabold">{lastName}</span>
        </p>
        <p class="w-max rounded-full bg-white/8 px-3 py-0.5 text-[0.6875rem] font-light text-text sm:px-4.5 sm:py-1 sm:text-xs xl:mx-auto">
          {title}
        </p>
      </div>
    </header>

    <!-- ── Expandable Details ── -->
    <div
      id="sidebar-details"
      class="invisible opacity-0 transition-all duration-500 ease-in-out xl:visible xl:opacity-100"
    >
      <!-- Separator -->
      <hr class="my-4 h-0.5 w-full border-0 bg-glass-border sm:my-8" />

      <!-- Contacts -->
      <address class="not-italic">
        <ul class="grid grid-cols-1 gap-4 sm:gap-5 md:grid-cols-2 md:gap-x-4 md:gap-y-8 xl:grid-cols-1">
          <li class="flex items-center gap-4 min-inline-full">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-blueviolet bg-card text-blueviolet shadow-1 transition-all hover:shadow-3 sm:size-12 sm:text-lg pointer-fine:hover:-translate-y-1">
              <img
                src="/assets/icons/contact/email.svg"
                alt="Email"
                class="size-5 sm:size-6 object-contain"
                width="24"
                height="24"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="mbe-0.5 text-[0.6875rem] text-text-muted/70 uppercase sm:text-xs">Email</p>
              <span class="block text-[0.8125rem] text-text sm:text-[0.9375rem] xl:overflow-hidden xl:text-ellipsis xl:whitespace-nowrap">
                {contact.email}
              </span>
            </div>
          </li>

          <li class="flex items-center gap-4 min-inline-full">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-blueviolet bg-card text-blueviolet shadow-1 transition-all hover:shadow-3 sm:size-12 sm:text-lg pointer-fine:hover:-translate-y-1">
              <img
                src="/assets/icons/contact/phone.svg"
                alt="Phone"
                class="size-5 sm:size-6 object-contain"
                width="24"
                height="24"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="mbe-0.5 text-[0.6875rem] text-text-muted/70 uppercase sm:text-xs">Phone</p>
              <span class="block text-[0.8125rem] text-text sm:text-[0.9375rem] xl:overflow-hidden xl:text-ellipsis xl:whitespace-nowrap">
                {contact.phone}
              </span>
            </div>
          </li>

          <li class="flex items-center gap-4 min-inline-full">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-blueviolet bg-card text-blueviolet shadow-1 transition-all hover:shadow-3 sm:size-12 sm:text-lg pointer-fine:hover:-translate-y-1">
              <img
                src="/assets/icons/contact/location.svg"
                alt="Location"
                class="size-5 sm:size-6 object-contain"
                width="24"
                height="24"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="mbe-0.5 text-[0.6875rem] text-text-muted/70 uppercase sm:text-xs">
                Location
              </p>
              <span class="block text-[0.8125rem] text-text sm:text-[0.9375rem] xl:overflow-hidden xl:text-ellipsis xl:whitespace-nowrap">
                {contact.location}
              </span>
            </div>
          </li>

          <li class="flex items-center gap-4 min-inline-full">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-blueviolet bg-card text-blueviolet shadow-1 transition-all hover:shadow-3 sm:size-12 sm:text-lg pointer-fine:hover:-translate-y-1">
              <img
                src="/assets/icons/contact/linkedin.svg"
                alt="LinkedIn"
                class="size-5 sm:size-6 object-contain"
                width="24"
                height="24"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="mbe-0.5 text-[0.6875rem] text-text-muted/70 uppercase sm:text-xs">
                LinkedIn
              </p>
              <span class="block text-[0.8125rem] text-text sm:text-[0.9375rem] xl:overflow-hidden xl:text-ellipsis xl:whitespace-nowrap">
                {contact.linkedin}
              </span>
            </div>
          </li>

          <li class="flex items-center gap-4 min-inline-full">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full border-2 border-blueviolet bg-card text-blueviolet shadow-1 transition-all hover:shadow-3 sm:size-12 sm:text-lg pointer-fine:hover:-translate-y-1">
              <img
                src="/assets/icons/contact/github.svg"
                alt="GitHub"
                class="size-5 sm:size-6 object-contain"
                width="24"
                height="24"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="mbe-0.5 text-[0.6875rem] text-text-muted/70 uppercase sm:text-xs">GitHub</p>
              <span class="block text-[0.8125rem] text-text sm:text-[0.9375rem] xl:overflow-hidden xl:text-ellipsis xl:whitespace-nowrap">
                {contact.github}
              </span>
            </div>
          </li>
        </ul>
      </address>

      <!-- Separator -->
      <hr class="my-4 h-0.5 w-full border-0 bg-glass-border sm:my-8" />

      <!-- Languages -->
      <section aria-label="Languages">
        <h3 class="mbe-4 text-[0.6875rem] font-medium tracking-[0.2em] text-blueviolet uppercase sm:text-xs">
          Languages
        </h3>
        <dl class="space-y-2">
          {languages.map((lang) => (
            <div class="flex justify-between text-[0.8125rem] text-text-muted sm:text-[0.9375rem]">
              <dt>{lang.name}</dt>
              <dd>{lang.level}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </aside>

  <!-- Toggle Button -->
  <button
    id="sidebar-toggle-btn"
    type="button"
    class="absolute top-0 right-0 z-20 flex cursor-pointer items-center justify-center gap-1 rounded-tl-none rounded-tr-card rounded-br-none rounded-bl-card border-2 border-t-0 border-r-0 border-glass-border bg-card px-2.5 py-2.5 text-[0.8125rem] text-blueviolet shadow-2 transition-all sm:min-w-32 sm:px-4 sm:py-2.5 xl:hidden pointer-fine:hover:bg-white/10 pointer-fine:hover:text-violet"
    aria-label="Show Contacts"
    aria-expanded="false"
  >
    <span
      id="sidebar-toggle-label"
      class="hidden text-xs sm:block"
    >
      Show Contacts
    </span>
    <span class="sm:hidden">
      <svg
        id="sidebar-icon-up"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden size-5"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
      <svg
        id="sidebar-icon-down"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="size-5"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </span>
  </button>
</div>

<script src="@shared/scripts/sidebar.ts"></script>
