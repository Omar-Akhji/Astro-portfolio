---
interface NavLink {
  readonly name: string;
  readonly path: string;
}

const pathname = Astro.url.pathname;
// Strip trailing slash except for root path
const currentPath = pathname === "/" ? "/" : pathname.replace(/\/$/, "");

const isLinkActive = (path: string): boolean => {
  if (path === "/") return currentPath === "/";
  return currentPath === path || currentPath.startsWith(path + "/");
};

const links: readonly NavLink[] = [
  { name: "About", path: "/" },
  { name: "Resume", path: "/resume" },
  { name: "Projects", path: "/projects" },
  { name: "Contact", path: "/contact" },
];
---

<nav class="fixed bottom-0 left-0 z-20 mx-3 mb-0 w-[calc(100%-1.5rem)] rounded-t-card border-2 border-glass-border bg-card/75 shadow-2 backdrop-blur-md lg:absolute lg:top-0 lg:right-0 lg:bottom-auto lg:left-auto lg:m-0 lg:w-max lg:rounded-none lg:rounded-tr-card lg:rounded-bl-card lg:px-5 lg:shadow-none">
  <ul class="flex flex-wrap items-center justify-center gap-1.5 px-2 py-0 xs:gap-2 sm:gap-3 lg:gap-7 lg:px-5">
    {links.map((link) => {
      const isActive = isLinkActive(link.path);
      return (
        <li>
          <a
            aria-current={isActive ? "page" : undefined}
            aria-label={link.name}
            class:list={[
              "group relative flex items-center justify-center px-2.5 py-3 text-[0.75rem] transition-colors xs:px-3 xs:py-3.5 xs:text-[0.8125rem] sm:px-4 sm:text-[0.875rem] md:text-[0.9375rem] lg:block lg:px-1.5 lg:py-5 lg:active:scale-100",
              {
                "font-bold text-blueviolet": isActive,
                "font-medium text-text-muted hover:text-text active:scale-95": !isActive,
              },
            ]}
            href={link.path}
            title={link.name}
          >
            {isActive && (
              <span class="absolute -top-0.5 left-1/2 z-10 h-0.5 w-3/4 -translate-x-1/2 rounded-full bg-linear-to-r from-violet to-blueviolet shadow-[0_0_8px_var(--color-blueviolet)] lg:top-auto lg:-bottom-0.5" />
            )}
            {link.name}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
