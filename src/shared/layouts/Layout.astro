---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import CustomCursor from "@shared/components/ui/CustomCursor.astro";
import Footer from "@shared/components/layout/Footer.astro";
import Navbar from "@shared/components/layout/Navbar.astro";
import Sidebar from "@shared/components/layout/Sidebar.astro";
import AboutSkeleton from "@features/about/components/AboutSkeleton.astro";
import BlogSkeleton from "@features/blog/components/BlogSkeleton.astro";
import ContactSkeleton from "@features/contact/components/ContactSkeleton.astro";
import PortfolioSkeleton from "@features/portfolio/components/PortfolioSkeleton.astro";
import ResumeSkeleton from "@features/resume/components/ResumeSkeleton.astro";
import resumeData from "@shared/data/resumeData.json";
import SEO from "@shared/seo/SEO.astro";
import type { SeoProps } from "@shared/types/seo";

interface Props extends SeoProps {}
---

<!doctype html>
<html
  class="font-sans"
  lang="en"
>
  <head>
    <meta charset="utf-8" />
    <meta
      content="width=device-width"
      name="viewport"
    />
    <link
      href="/favicon.svg"
      rel="icon"
      type="image/svg+xml"
    />
    <link
      href="/favicon.ico"
      rel="icon"
    />
    <meta
      content={Astro.generator}
      name="generator"
    />

    <SEO {...Astro.props} />
    <ClientRouter />

    <link
      href="https://fonts.googleapis.com"
      rel="preconnect"
    />
    <link
      crossorigin
      href="https://fonts.gstatic.com"
      rel="preconnect"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="relative min-h-screen bg-bg font-sans leading-[1.6] text-text antialiased">
    <CustomCursor />

    <div class="mx-auto my-4 mb-18.75 px-3 min-w-64.75 sm:mt-15 sm:mb-25 sm:max-w-5xl sm:px-4 md:px-6 xl:flex xl:max-w-300 xl:items-stretch xl:justify-center xl:gap-6">
      <Sidebar
        contact={resumeData.personal.contact}
        initials={resumeData.personal.initials}
        languages={resumeData.personal.languages}
        name={resumeData.personal.name}
        title={resumeData.personal.title}
      />
      <div class="relative w-full min-w-0 lg:mx-auto xl:mx-0 xl:w-3/4">
        <Navbar />
        <main>
          <!-- Skeleton container: hidden by default, shown during navigation -->
          <div
            aria-hidden="true"
            class="hidden"
            id="skeleton-container"
          >
            <div
              class="hidden"
              data-skeleton="/"
            >
              <AboutSkeleton />
            </div>
            <div
              class="hidden"
              data-skeleton="/resume"
            >
              <ResumeSkeleton />
            </div>
            <div
              class="hidden"
              data-skeleton="/portfolio"
            >
              <PortfolioSkeleton />
            </div>
            <div
              class="hidden"
              data-skeleton="/blog"
            >
              <BlogSkeleton />
            </div>
            <div
              class="hidden"
              data-skeleton="/contact"
            >
              <ContactSkeleton />
            </div>
          </div>

          <!-- Actual page content -->
          <div id="page-content">
            <slot />
          </div>
        </main>
        <Footer />
      </div>
    </div>
    <script src="@shared/scripts/transitions.ts"></script>
  </body>
</html>
