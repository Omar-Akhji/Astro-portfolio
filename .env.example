# Resend Configuration for Contact Form
# Copy this file to .env.local and fill in your credentials
# Sign up at https://resend.com (free tier: 3,000 emails/month)

# Your Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# The "from" email address (must be verified in Resend, or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where to receive contact form emails
CONTACT_TO_EMAIL=your-email@gmail.com
