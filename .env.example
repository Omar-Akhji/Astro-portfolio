# SMTP Configuration for Contact Form (Nodemailer)
# Copy this file to .env.local and fill in your credentials

# SMTP Server details (e.g. smtp.gmail.com, smtp.resend.com, mail.privateemail.com, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Addresses
CONTACT_TO_EMAIL=your-email@gmail.com
CONTACT_FROM_EMAIL=portfolio@example.com

# MCP Server Credentials (Optional)
# Google Cloud Service Account Credentials for Search Console MCP
# Provide absolute path to your JSON service account credentials file
# GOOGLE_APPLICATION_CREDENTIALS="C:/Users/YourName/path/to/credentials.json"

# Google PageSpeed Insights API Key for PageSpeed MCP
# GOOGLE_API_KEY="your-google-api-key"

